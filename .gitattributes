# 统一用 LF 存储，消除 Windows 下的 CRLF 警告
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.lua    text eol=lf
*.http   text eol=lf

# PowerShell 脚本在 Windows 上习惯 CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制
*.jar    binary
*.png    binary
*.jpg    binary
